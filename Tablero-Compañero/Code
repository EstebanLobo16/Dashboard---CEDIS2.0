function setup() {
  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  if (!spreadsheet) {
    throw new Error('Abre este proyecto desde Extensiones → Apps Script dentro del Sheet.');
  }

  const schemas = expectedSchemas_();
  Object.keys(schemas).forEach((name) => {
    const sheet = spreadsheet.getSheetByName(name) || spreadsheet.insertSheet(name);
    if (!sheet.getLastRow()) {
      sheet.getRange(1, 1, 1, schemas[name].length).setValues([schemas[name]]);
      return;
    }
    const headers = sheet.getRange(1, 1, 1, schemas[name].length).getValues()[0]
      .map((value) => String(value).trim());
    if (JSON.stringify(headers) !== JSON.stringify(schemas[name])) {
      throw new Error(`El esquema existente de ${name} no coincide con Macintosh.`);
    }
  });

  PropertiesService.getScriptProperties().setProperty(
    MACINTOSH_CONFIG.spreadsheetProperty,
    spreadsheet.getId()
  );

  return {
    ok: true,
    spreadsheetId: spreadsheet.getId(),
    spreadsheetName: spreadsheet.getName(),
  };
}

