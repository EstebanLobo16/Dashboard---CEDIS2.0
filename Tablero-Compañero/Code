/** Ejecuta una vez y copia el token del registro de ejecución al .env de Macintosh. */
function createSyncToken() {
  const token = `${Utilities.getUuid()}${Utilities.getUuid()}`.replace(/-/g, '');
  PropertiesService.getScriptProperties().setProperty(MACINTOSH_CONFIG.tokenProperty, token);
  Logger.log(`MACINTOSH_APPS_SCRIPT_TOKEN=${token}`);
  console.log(`MACINTOSH_APPS_SCRIPT_TOKEN=${token}`);
  return 'Token creado. Cópialo del registro de ejecución y guárdalo en el .env de Macintosh.';
}

function syncStatus() {
  const properties = PropertiesService.getScriptProperties();
  const status = {
    spreadsheetConfigured: Boolean(properties.getProperty(MACINTOSH_CONFIG.spreadsheetProperty)),
    tokenConfigured: Boolean(properties.getProperty(MACINTOSH_CONFIG.tokenProperty)),
    lastSyncAt: properties.getProperty('MACINTOSH_LAST_SYNC_AT') || '',
    lastPeriod: properties.getProperty('MACINTOSH_LAST_SYNC_PERIOD') || '',
  };
  console.log(JSON.stringify(status, null, 2));
  return status;
}

function doPost(event) {
  const lock = LockService.getScriptLock();
  try {
    const request = parseSyncRequest_(event);
    validateSyncRequest_(request);
    if (!lock.tryLock(30000)) {
      throw new Error('Otra sincronización sigue en curso. Intenta nuevamente en unos segundos.');
    }
    return jsonResponse_(replaceReport_(request));
  } catch (error) {
    return jsonResponse_({ok: false, error: error.message || String(error)});
  } finally {
    if (lock.hasLock()) lock.releaseLock();
  }
}

function importMacintoshPackage(contents) {
  if (!canCurrentUserUpdate_()) {
    throw new Error('Tu cuenta no tiene permiso para actualizar este reporte.');
  }
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(30000)) {
    throw new Error('Otra actualización sigue en curso. Intenta nuevamente en unos segundos.');
  }
  try {
    let request;
    try {
      request = JSON.parse(String(contents || ''));
    } catch (error) {
      throw new Error('El archivo seleccionado no es un paquete válido de Macintosh.');
    }
    validatePortablePackage_(request);
    return replaceReport_(request);
  } finally {
    if (lock.hasLock()) lock.releaseLock();
  }
}

function replaceReport_(request) {
  const spreadsheet = getSpreadsheet_();
  const order = ['FiltroCurso', 'Colaborador', 'Curso', 'Tienda', 'Region', 'Control', 'Resumen'];
  const rowCounts = {};
  const updates = order.map((sheetName) => {
    const source = request.sheets[sheetName];
    const sheet = spreadsheet.getSheetByName(sheetName) || spreadsheet.insertSheet(sheetName);
    return {sheetName, source, sheet, values: mergeHistoricalValues_(sheet, source, request)};
  });
  updates.forEach(({sheetName, source, sheet, values}) => {
    if (sheet.getMaxRows() < values.length) {
      sheet.insertRowsAfter(sheet.getMaxRows(), values.length - sheet.getMaxRows());
    }
    if (sheet.getMaxColumns() < source.columns.length) {
      sheet.insertColumnsAfter(sheet.getMaxColumns(), source.columns.length - sheet.getMaxColumns());
    }
    sheet.clearContents();
    sheet.getRange(1, 1, values.length, source.columns.length).setValues(values);
    rowCounts[sheetName] = source.rows.length;
  });
  SpreadsheetApp.flush();
  const syncedAt = new Date().toISOString();
  PropertiesService.getScriptProperties().setProperties({
    MACINTOSH_LAST_SYNC_AT: syncedAt,
    MACINTOSH_LAST_SYNC_REPORT: request.report,
    MACINTOSH_LAST_SYNC_PERIOD: String(request.period || ''),
    MACINTOSH_LAST_SYNC_BY: currentUserEmail_(),
  });
  return {ok: true, report: request.report, period: request.period,
    syncedAt, updatedSheets: order, rows: rowCounts};
}

function mergeHistoricalValues_(sheet, source, request) {
  const existing = sheet.getLastRow() ? sheet.getDataRange().getValues() : [];
  if (!existing.length || !existing[0].some((value) => String(value).trim())) {
    return [source.columns].concat(source.rows);
  }
  const currentHeaders = existing[0].map((value) => String(value).trim());
  if (JSON.stringify(currentHeaders) !== JSON.stringify(source.columns)) {
    throw new Error(`El esquema existente de ${sheet.getName()} no coincide con el paquete.`);
  }
  const reportIndex = source.columns.indexOf('reporte');
  const cutoffIndex = source.columns.indexOf('fecha_corte');
  const periodIndex = source.columns.indexOf('periodo');
  const versionIndex = cutoffIndex >= 0 ? cutoffIndex : periodIndex;
  const targetVersion = cutoffIndex >= 0 ? String(request.cutoffDate || '') : String(request.period || '');
  if (reportIndex < 0 || versionIndex < 0 || !targetVersion) {
    throw new Error(`No fue posible determinar el corte histórico de ${sheet.getName()}.`);
  }
  const keptRows = existing.slice(1)
    .filter((row) => row.some((value) => value !== '' && value !== null))
    .filter((row) => {
      const sameReport = normalize_(row[reportIndex]) === normalize_(request.report);
      const sameVersion = historicalValue_(row[versionIndex]) === targetVersion;
      return !(sameReport && sameVersion);
    });
  const mergedRows = keptRows.concat(source.rows);
  mergedRows.sort((left, right) => {
    const byVersion = historicalValue_(left[versionIndex]).localeCompare(historicalValue_(right[versionIndex]));
    if (byVersion) return byVersion;
    return normalize_(left[reportIndex]).localeCompare(normalize_(right[reportIndex]));
  });
  return [source.columns].concat(mergedRows);
}

function historicalValue_(value) {
  return value instanceof Date
    ? Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd')
    : String(value == null ? '' : value).trim();
}

function parseSyncRequest_(event) {
  if (!event || !event.postData || !event.postData.contents) throw new Error('La solicitud no contiene JSON.');
  try {
    return JSON.parse(event.postData.contents);
  } catch (error) {
    throw new Error('El cuerpo de la solicitud no es JSON válido.');
  }
}

function validateSyncRequest_(request) {
  const savedToken = PropertiesService.getScriptProperties().getProperty(MACINTOSH_CONFIG.tokenProperty);
  if (!savedToken) throw new Error('Primero ejecuta createSyncToken en Apps Script.');
  if (!request || request.token !== savedToken) throw new Error('Token de sincronización inválido.');
  if (request.action !== 'replace_report') throw new Error('Acción de sincronización no permitida.');
  validateReport_(request.report);
  validateTables_(request);
}

function validatePortablePackage_(request) {
  if (!request || request.format !== 'macintosh-report-package' || Number(request.version) !== 1) {
    throw new Error('El formato o la versión del paquete no es compatible.');
  }
  if (request.action !== 'manual_import') throw new Error('El paquete no permite actualización manual.');
  validateReport_(request.report);
  validateTables_(request);
  const summary = request.sheets.Resumen.rows[request.sheets.Resumen.rows.length - 1];
  if (String(summary[1] || '') !== String(request.period || '')) {
    throw new Error('El periodo del manifiesto no coincide con el Resumen.');
  }
  const declared = request.manifest && request.manifest.rowCounts;
  if (!declared || Object.keys(expectedSchemas_()).some((name) => Number(declared[name]) !== request.sheets[name].rows.length)) {
    throw new Error('El manifiesto de filas no coincide con el contenido del paquete.');
  }
}

function expectedSchemas_() {
  return {
    Resumen: ['reporte','periodo','fecha_corte','colaboradores','cursos_asignados','cursos_completados','cursos_pendientes','avance'],
    Region: ['reporte','periodo','fecha_corte','region','colaboradores','cursos_asignados','cursos_completados','cursos_pendientes','avance'],
    Tienda: ['reporte','periodo','fecha_corte','region','tienda','gerente_zona','colaboradores','cursos_asignados','cursos_completados','cursos_pendientes','avance'],
    Curso: ['reporte','periodo','fecha_corte','curso_clave','curso','iniciativa','asignados','completados','pendientes','avance'],
    Colaborador: ['reporte','periodo','fecha_corte','numero_empleado','nombre','fecha_contratacion','codigo_puesto','puesto','departamento','region','tienda','gerente_zona','dias_laborados','nuevo_ingreso','cursos_asignados','cursos_completados','cursos_pendientes','avance','lista_pendientes'],
    FiltroCurso: ['reporte','periodo','puesto','region','curso_clave','curso','iniciativa','asignados','completados','pendientes','avance'],
    Control: ['reporte','periodo','fecha_corte','revision','publicacion_actual','colaboradores_publicados','colaboradores_exportados','cursos_asignados','cursos_completados','cursos_pendientes','conciliacion_correcta'],
  };
}

function validateTables_(request) {
  const expected = expectedSchemas_();
  if (!request.sheets || typeof request.sheets !== 'object') throw new Error('Falta el contenido de las pestañas.');
  let totalCells = 0;
  Object.keys(expected).forEach((sheetName) => {
    const table = request.sheets[sheetName];
    if (!table || !Array.isArray(table.columns) || !Array.isArray(table.rows)) {
      throw new Error(`La pestaña ${sheetName} no tiene una tabla válida.`);
    }
    if (JSON.stringify(table.columns) !== JSON.stringify(expected[sheetName])) {
      throw new Error(`El esquema de ${sheetName} no coincide con el esperado.`);
    }
    if (table.rows.some((row) => !Array.isArray(row) || row.length !== table.columns.length)) {
      throw new Error(`Una fila de ${sheetName} tiene un número incorrecto de columnas.`);
    }
    totalCells += (table.rows.length + 1) * table.columns.length;
  });
  if (!request.sheets.Resumen.rows.length) throw new Error('Resumen no contiene datos.');
  if (totalCells > 1500000) throw new Error('La publicación supera el límite de 1,500,000 celdas.');
}

function currentUserEmail_() {
  return String(Session.getActiveUser().getEmail() || '').toLowerCase();
}

function canCurrentUserUpdate_() {
  return MACINTOSH_CONFIG.administrators.indexOf(currentUserEmail_()) !== -1;
}

function jsonResponse_(value) {
  return ContentService.createTextOutput(JSON.stringify(value)).setMimeType(ContentService.MimeType.JSON);
}

function include(filename) {
  return HtmlService.createHtmlOutputFromFile(filename).getContent();
}

function getDashboardData() {
  const summaryRows = readTable_(MACINTOSH_CONFIG.sheets.summary);
  const selectedReport = MACINTOSH_CONFIG.reportKey;
  const currentUrl = ScriptApp.getService().getUrl() || '';
  const availableReports = MACINTOSH_CONFIG.reports.map((report) => ({
    key: report.key,
    name: report.name,
    url: report.key === selectedReport ? currentUrl : report.url,
    current: report.key === selectedReport,
  }));
  const base = {
    title: MACINTOSH_CONFIG.title,
    report: selectedReport,
    reportName: reportName_(selectedReport),
    availableReports,
    generatedAt: Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy-MM-dd'T'HH:mm:ss"),
    canUpdate: canCurrentUserUpdate_(),
  };
  const reportRows = summaryRows.filter((row) => normalize_(row.reporte) === selectedReport);
  if (!reportRows.length) {
    return Object.assign(base, {
      empty: true,
      summary: null,
      control: {},
      regions: [],
      stores: [],
      courses: [],
      positions: [],
    });
  }

  const summary = latestRow_(reportRows);
  const period = String(summary.periodo || '');
  const cutoff = String(summary.fecha_corte || '');
  const allRegions = readTable_(MACINTOSH_CONFIG.sheets.regions);
  const allStores = readTable_(MACINTOSH_CONFIG.sheets.stores);
  const allCourses = readTable_(MACINTOSH_CONFIG.sheets.courses);
  const allEmployees = readTable_(MACINTOSH_CONFIG.sheets.employees);
  const controlRows = readTable_(MACINTOSH_CONFIG.sheets.control);
  const belongsToSelection = (row) => normalize_(row.reporte) === selectedReport &&
    (!period || String(row.periodo || '') === period) &&
    (!cutoff || !row.fecha_corte || String(row.fecha_corte) === cutoff);
  const regions = allRegions.filter(belongsToSelection);
  const stores = allStores.filter(belongsToSelection);
  const courses = allCourses.filter(belongsToSelection);
  const employees = allEmployees.filter(belongsToSelection);
  const control = latestRow_(controlRows.filter(belongsToSelection)) || {};
  return Object.assign(base, {
    empty: false,
    summary,
    control,
    regions: regions.sort((a, b) => number_(a.avance) - number_(b.avance)),
    stores: stores.sort((a, b) => number_(a.avance) - number_(b.avance)),
    courses: courses.sort((a, b) => number_(a.avance) - number_(b.avance)),
    positions: [...new Set(employees.map((row) => row.puesto).filter(Boolean))].sort(),
  });
}

function searchEmployees(request) {
  const options = request || {};
  const report = MACINTOSH_CONFIG.reportKey;
  const period = String(options.period || '').trim();
  const cutoff = String(options.cutoffDate || '').trim();
  const query = normalize_(options.query || '');
  const region = normalize_(options.region || '');
  const position = normalize_(options.position || '');
  const course = normalize_(options.course || '');
  const store = String(options.store || '').trim();
  const page = Math.max(1, Number(options.page) || 1);
  const pageSize = Math.min(50, Math.max(10, Number(options.pageSize) || 20));

  let people = readTable_(MACINTOSH_CONFIG.sheets.employees);
  people = people.filter((row) => {
    const matchesQuery = !query || [
      row.numero_empleado,
      row.nombre,
      row.puesto,
      row.departamento,
      row.gerente_zona,
    ].some((value) => normalize_(value).includes(query));
    const matchesReport = !report || normalize_(row.reporte) === report;
    const matchesPeriod = !period || String(row.periodo || '') === period;
    const matchesCutoff = !cutoff || String(row.fecha_corte || '') === cutoff;
    const matchesRegion = !region || normalize_(row.region) === region;
    const matchesPosition = !position || normalize_(row.puesto) === position;
    const matchesStore = !store || String(row.tienda || '') === store;
    return matchesQuery && matchesReport && matchesPeriod && matchesCutoff && matchesRegion && matchesPosition && matchesStore;
  });

  const catalog = readTable_(MACINTOSH_CONFIG.sheets.courses)
    .filter((row) => (!report || normalize_(row.reporte) === report) &&
      (!period || String(row.periodo || '') === period) &&
      (!cutoff || String(row.fecha_corte || '') === cutoff))
    .map((row) => String(row.curso || '').trim())
    .filter(Boolean)
    .sort((a, b) => normalize_(b).length - normalize_(a).length);
  const selectedCatalog = course ? catalog.filter((name) => normalize_(name) === course) : catalog;
  const rows = [];
  people.forEach((person) => {
    let pendingText = normalize_(person.lista_pendientes || '');
    selectedCatalog.forEach((courseName) => {
      const needle = normalize_(courseName);
      const index = pendingText.indexOf(needle);
      if (index === -1) return;
      rows.push({
        numero_empleado: person.numero_empleado,
        nombre: person.nombre,
        puesto: person.puesto,
        region: person.region,
        tienda: person.tienda,
        curso_pendiente: courseName,
      });
      pendingText = pendingText.slice(0, index) + ' '.repeat(needle.length) + pendingText.slice(index + needle.length);
    });
  });

  rows.sort((a, b) => String(a.nombre).localeCompare(String(b.nombre), 'es') || String(a.curso_pendiente).localeCompare(String(b.curso_pendiente), 'es'));
  const total = rows.length;
  const start = (page - 1) * pageSize;

  return {
    page,
    pageSize,
    total,
    totalPages: Math.max(1, Math.ceil(total / pageSize)),
    rows: rows.slice(start, start + pageSize),
  };
}

function getFilteredOverview(request) {
  const options = request || {};
  const report = MACINTOSH_CONFIG.reportKey;
  const period = String(options.period || '').trim();
  const cutoff = String(options.cutoffDate || '').trim();
  const region = normalize_(options.region || '');
  const position = normalize_(options.position || '');
  const course = normalize_(options.course || '');
  const filterTable = readOptionalTable_('FiltroCurso');
  if (!filterTable.length) {
    throw new Error('Falta la pestaña técnica FiltroCurso. Exporta nuevamente el reporte desde Macintosh.');
  }
  const courseRows = filterTable.filter((row) =>
    (!report || normalize_(row.reporte) === report) &&
    (!period || String(row.periodo || '') === period) &&
    (!region || normalize_(row.region) === region) &&
    (!position || normalize_(row.puesto) === position) &&
    (!course || normalize_(row.curso_clave) === course || normalize_(row.curso) === course)
  );
  const employeeRows = readTable_(MACINTOSH_CONFIG.sheets.employees).filter((row) =>
    (!report || normalize_(row.reporte) === report) &&
    (!period || String(row.periodo || '') === period) &&
    (!cutoff || String(row.fecha_corte || '') === cutoff) &&
    (!region || normalize_(row.region) === region) &&
    (!position || normalize_(row.puesto) === position)
  );
  const totals = course
    ? courseRows.reduce((result, row) => {
        result.colaboradores += number_(row.asignados);
        result.asignados += number_(row.asignados);
        result.completados += number_(row.completados);
        result.pendientes += number_(row.pendientes);
        return result;
      }, {colaboradores: 0, asignados: 0, completados: 0, pendientes: 0})
    : employeeRows.reduce((result, row) => {
        result.colaboradores += 1;
        result.asignados += number_(row.cursos_asignados);
        result.completados += number_(row.cursos_completados);
        result.pendientes += number_(row.cursos_pendientes);
        return result;
      }, {colaboradores: 0, asignados: 0, completados: 0, pendientes: 0});
  totals.avance = totals.asignados ? totals.completados / totals.asignados : 0;

  const regionMap = {};
  const courseMap = {};
  const regionSource = course ? courseRows : employeeRows;
  regionSource.forEach((row) => {
    const regionName = String(row.region || 'Sin región');
    if (!regionMap[regionName]) regionMap[regionName] = {region: regionName, colaboradores: 0, cursos_asignados: 0, cursos_completados: 0, cursos_pendientes: 0};
    regionMap[regionName].colaboradores += course ? number_(row.asignados) : 1;
    regionMap[regionName].cursos_asignados += number_(course ? row.asignados : row.cursos_asignados);
    regionMap[regionName].cursos_completados += number_(course ? row.completados : row.cursos_completados);
    regionMap[regionName].cursos_pendientes += number_(course ? row.pendientes : row.cursos_pendientes);
  });
  courseRows.forEach((row) => {
    const courseKey = String(row.curso_clave || row.curso || '');
    if (!courseMap[courseKey]) courseMap[courseKey] = {curso_clave: courseKey, curso: row.curso, asignados: 0, completados: 0};
    courseMap[courseKey].asignados += number_(row.asignados);
    courseMap[courseKey].completados += number_(row.completados);
  });
  const regions = Object.values(regionMap).map((row) => ({
    ...row,
    avance: row.cursos_asignados ? row.cursos_completados / row.cursos_asignados : 0,
  }));
  const courses = Object.values(courseMap).map((row) => ({
    ...row,
    pendientes: row.asignados - row.completados,
    avance: row.asignados ? row.completados / row.asignados : 0,
  }));
  return { totals, regions, courses };
}

function validateReport_(reportKey) {
  const report = normalize_(reportKey);
  if (report !== MACINTOSH_CONFIG.reportKey) {
    throw new Error(`Este tablero solo acepta paquetes de ${reportName_(MACINTOSH_CONFIG.reportKey)}.`);
  }
}

function reportName_(reportKey) {
  return ({
    almacenista: 'Almacenista',
    asesor: 'Asesor',
    cajero: 'Cajero',
    gerente: 'Gerente',
    gerente_zona: 'Gerente de Zona',
  })[normalize_(reportKey)] || String(reportKey || 'Reporte');
}

function latestRow_(rows) {
  return rows.slice().sort((left, right) => {
    const leftVersion = String(left.fecha_corte || left.periodo || '');
    const rightVersion = String(right.fecha_corte || right.periodo || '');
    return leftVersion.localeCompare(rightVersion);
  }).pop();
}

function getSpreadsheet_() {
  const id = PropertiesService.getScriptProperties().getProperty(
    MACINTOSH_CONFIG.spreadsheetProperty
  );
  if (!id) {
    throw new Error('Configuración pendiente. Ejecuta la función setup una vez desde el editor.');
  }
  return SpreadsheetApp.openById(id);
}

function readTable_(sheetName) {
  const sheet = getSpreadsheet_().getSheetByName(sheetName);
  if (!sheet) {
    throw new Error(`No existe la pestaña ${sheetName}.`);
  }

  const values = sheet.getDataRange().getValues();
  if (values.length < 2) return [];

  const headers = values[0].map((value) => String(value).trim());
  return values.slice(1)
    .filter((row) => row.some((value) => value !== '' && value !== null))
    .map((row) => headers.reduce((item, header, index) => {
      item[header] = serializable_(row[index]);
      return item;
    }, {}));
}

function readOptionalTable_(sheetName) {
  const sheet = getSpreadsheet_().getSheetByName(sheetName);
  return sheet ? readTable_(sheetName) : [];
}

function serializable_(value) {
  if (value instanceof Date) {
    return Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  }
  return value;
}

function normalize_(value) {
  return String(value == null ? '' : value)
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim();
}

function number_(value) {
  const result = Number(value);
  return Number.isFinite(result) ? result : 0;
}

function boolean_(value) {
  return value === true || String(value).toLowerCase() === 'true' || Number(value) === 1;
}
